# Raw Strava export. Personal data: GPS-derived filenames, activity names,
# private notes. strava.py strips these at load, but the raw CSV must never
# be committed or pushed anywhere public.
sources/activities.csv

# Regenerated by `python build.py`. The corpus of record lives on the Hub at
# hoodarunner/running-coach-sft; no reason to version 3MB of derived JSONL.
data/*.jsonl
data/seed_plans.json
data/stats.json

# Model generations, pulled from hoodarunner/running-coach-evals
generations/
runs/

# One-shot patch scripts, kept locally, not part of the project
fix_local.py
fix_train.py

__pycache__/
*.py[cod]
.venv/
venv/
.env
out/
.ipynb_checkpoints/
.DS_Store
